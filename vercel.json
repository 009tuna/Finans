{
  "version": 2,
  "rewrites": [
    { "source": "/api/forecast/montecarlo", "destination": "/api/forecast/montecarlo" },
    { "source": "/api/forecast/correlation", "destination": "/api/forecast/correlation" },
    { "source": "/api/forecast/dcf",         "destination": "/api/forecast/dcf" },
    { "source": "/api/forecast/scenarios",   "destination": "/api/forecast/scenarios" },
    { "source": "/api/(.*)",                 "destination": "/api/$1" }
  ],
  "functions": {
    "api/refresh.js":                   { "maxDuration": 60 },
    "api/forecast/montecarlo.js":       { "maxDuration": 60 },
    "api/forecast/correlation.js":      { "maxDuration": 60 },
    "api/backtest.js":                  { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
