# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local git'e gitmez (.gitignore'da). Vercel'de aynı değerleri
# Project Settings > Environment Variables altına ekleyin.

# --- Supabase (zorunlu) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # okuma (tarayıcıya gidebilir)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # yazma (GİZLİ — sadece sunucu/cron)

# --- Veri kaynağı ---
FINNHUB_TOKEN=xxxx                  # ABD hisse temel/analist verisi

# --- Yazma işlemleri için admin parolası (refresh + portföy kaydet) ---
# Vercel'de MUTLAKA ayarlayın; aksi halde üretimde yazma uçları 401 döner.
ADMIN_SECRET=uzun-rastgele-bir-parola

# --- Sadece scripts/run-migration.js için (yerel migration çalıştırma) ---
# Supabase > Account > Access Tokens'tan üretilir. ASLA commit etmeyin.
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_PROJECT_REF=xbdxglqksoqlwlanwnui
